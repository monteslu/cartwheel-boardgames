; crokinole project settings
name = Crokinole
app = crokinole
main_scene = scenes/main.cwscene
app_id = org.cartwheel.crokinole
; aiming the shot (game.h): slide the disc along the shooting line, turn the aim, spin (when the Spin setting is on)
input.slide_left = key:a, key:left, pad:left, axis:lx-@0.5
input.slide_right = key:d, key:right, pad:right, axis:lx+@0.5
input.aim_left = key:q, key:z, pad:lshoulder, axis:rx-@0.5, axis:lt+@0.5
input.aim_right = key:e, key:x, pad:rshoulder, axis:rx+@0.5, axis:rt+@0.5
input.spin_up = key:w, key:up, pad:up
input.spin_down = key:s, key:down, pad:down
; hold for power, let go to flick
input.flick = key:space, key:enter, pad:south
input.cancel = key:backspace, pad:east
input.replay = key:r, pad:north
render.width = 1280
render.height = 720
render.vsync = true
